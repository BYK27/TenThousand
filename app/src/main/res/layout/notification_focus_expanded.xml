<?xml version="1.0" encoding="utf-8"?>
<!--
    Prošireni prikaz (kad korisnik razvuče notifikaciju).
    Ovde su i dva dugmeta; klik im dodeljuje FocusNotifications preko
    setOnClickPendingIntent, jer RemoteViews nema onClick iz XML-a.

    Dugmad su TextView, a ne Button: Button u notifikaciji nasleđuje sistemsku
    temu i izgleda različito na različitim ROM-ovima, dok TextView sa vlastitim
    background drawable-om izgleda isto svuda.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="168dp">

    <ImageView
        android:id="@+id/notif_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/notif_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/notif_habit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp"
            android:letterSpacing="0.1" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <Chronometer
                android:id="@+id/notif_chrono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/notif_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B3FFFFFF"
                android:textSize="34sp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/notif_toggle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_notification_button"
                android:gravity="center"
                android:minWidth="104dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_stop"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_notification_button"
                android:gravity="center"
                android:minWidth="128dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="STOP &amp; SAVE"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
